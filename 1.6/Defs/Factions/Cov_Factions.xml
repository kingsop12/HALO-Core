<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef ParentName="CovFactionBase" Name="CovFactionBaseM" Abstract="True">
    <pawnSingular>Covenant Soldier</pawnSingular>
    <pawnsPlural>Cov Soldier</pawnsPlural>
    <categoryTag>Ultra</categoryTag>
    <listOrderPriority>99</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>The Arbiter</leaderTitle>
    <factionIconPath>World/WorldObjects/CovBase</factionIconPath>
    <techLevel>Ultra</techLevel>
    <factionNameMaker>Covenant_NamerFaction</factionNameMaker>
    <settlementNameMaker>Covenant_NamerFactionBases</settlementNameMaker>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Darkness</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HighLife</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">MaleSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FemaleSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Collectivist</li>
    </disallowedMemes>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Archist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Proselytizer</li>
    </requiredMemes>
    <backstoryFilters>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
        <commonality>0.05</commonality>
      </li>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
        <commonality>0.95</commonality>
      </li>
    </backstoryFilters>
    <caravanTraderKinds>
      <li>SangheiliTrader</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>SangheiliTrader</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>SangheiliTrader</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>CovRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <!-- Normal fights, standard mix -->
        <kindDef>Combat</kindDef>
        <options>
          <Cov_Ranger_Jackal>3</Cov_Ranger_Jackal>
          <Cov_Minor_Grunt>10</Cov_Minor_Grunt>
          <Cov_Major_Grunt>5</Cov_Major_Grunt>
          <Cov_Minor_Brute>3</Cov_Minor_Brute>
          <Cov_Major_Brute>3</Cov_Major_Brute>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <Cov_InvsElite>1</Cov_InvsElite>
          <Cov_Minor_Grunt>5</Cov_Minor_Grunt>
          <Cov_Minor_Elite>5</Cov_Minor_Elite>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>40</commonality>
        <options>
          <Cov_InvsElite>1</Cov_InvsElite>
          <Cov_Minor_Grunt>10</Cov_Minor_Grunt>
          <Cov_Ranger_Jackal>3</Cov_Ranger_Jackal>
          <Cov_Major_Elite>2</Cov_Major_Elite>
          <Cov_Minor_Elite>2</Cov_Minor_Elite>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Cov_Melee_Skirm>5</Cov_Melee_Skirm>
          <Cov_Minor_Skirm>6</Cov_Minor_Skirm>
          <Cov_Minor_Jackal>5</Cov_Minor_Jackal>
          <Cov_Minor_Grunt>10</Cov_Minor_Grunt>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Cov_Trade_Elite>1</Cov_Trade_Elite>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
          <Alpaca>2</Alpaca>
          <Elephant>1</Elephant>
        </carriers>
        <guards>
          <Villager>3</Villager>
          <Cov_Minor_Elite>2</Cov_Minor_Elite>
          <Cov_Minor_Grunt>5</Cov_Minor_Grunt>
          <Cov_Major_Grunt>1.5</Cov_Major_Grunt>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Cov_Minor_Skirm>16</Cov_Minor_Skirm>
          <Cov_Ranger_Jackal>3</Cov_Ranger_Jackal>
          <Cov_Melee_Skirm>11</Cov_Melee_Skirm>
          <Cov_Minor_Jackal>14</Cov_Minor_Jackal>
          <Cov_Minor_Grunt>15</Cov_Minor_Grunt>
          <Cov_Major_Grunt>5</Cov_Major_Grunt>
          <Cov_Minor_Brute>4</Cov_Minor_Brute>
          <Cov_Minor_Elite>4</Cov_Minor_Elite>
          <Cov_Major_Elite>2</Cov_Major_Elite>
          <Arbiter>0.01</Arbiter>
        </options>
      </li>
      <!-- 
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Miners</kindDef>
        <commonality>1</commonality>
        <options>
          <Miner>1</Miner>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Hunters</kindDef>
        <commonality>1</commonality>
        <options>
          <Hunter>1</Hunter>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Loggers</kindDef>
        <commonality>1</commonality>
        <options>
          <Logger>1</Logger>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Farmers</kindDef>
        <commonality>1</commonality>
        <options>
          <Farmer>1</Farmer>
        </options>
      </li>
      -->
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/CovBase</settlementTexturePath>
  </FactionDef> 
  
  <ThingSetMakerDef>
    <defName>CovRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>MedicineIndustrial</li>
            <li>ComponentIndustrial</li>
            <li>MealSurvivalPack</li>
            <li>Cov_Carbine</li>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>
  
  <FactionDef ParentName="CovFactionBaseM">
    <defName>CovenantMain</defName>
    <label>The Covenant</label>
    <description>A Large linking of Covenant bases collectively owned by the Covenant Empire.</description>
    <colorSpectrum>
      <li>(109,67,166)</li>
      <li>(109,67,166)</li>
    </colorSpectrum>
    <leaderTitle>The Arbiter</leaderTitle>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>99</configurationListOrderPriority>
  </FactionDef>

</Defs>