<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <PawnKindDef>
        <defName>Cov_Elite</defName>
        <label>Sangheili</label>
        <race>Human</race>
        <combatPower>85</combatPower>
        <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
        <backstoryCategories>
            <li>Outlander</li>
            <li>Offworld</li>
        </backstoryCategories>
        <chemicalAddictionChance>0</chemicalAddictionChance>
        <apparelMoney>1000~80000</apparelMoney>
        <defaultFactionType>CovenantMain</defaultFactionType>
        <apparelTags>
            <li>SangheiliMinorHelmet</li>
            <li>MinorPauldron</li>
            <li>SangheiliMinorArmor</li>
        </apparelTags>
        <apparelRequired>
            <li>MinorHelm</li>
            <li>MinorArmor</li>
            <li>Cov_MinorPauldron</li>
        </apparelRequired>
        <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
        <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
        <weaponMoney>900~1200</weaponMoney>
        <weaponTags>
            <li>Cov_PlasmaPistol</li>
            <li>Cov_EnergySword</li>
            <li>Cov_ELowTier</li>
        </weaponTags>
        <forceWeaponQuality>Masterwork</forceWeaponQuality>
        <initialWillRange>0</initialWillRange>
        <initialResistanceRange>0~1</initialResistanceRange>
        <requiredWorkTags>
            <li>Intellectual</li>
            <li>Crafting</li>
            <li>Shooting</li>
        </requiredWorkTags>
        <disallowedTraits>
            <li>BodyPurist</li>
        </disallowedTraits>
        <disallowedTraitsWithDegree>
            <PsychicSensitivity>-1</PsychicSensitivity>
            <PsychicSensitivity>-2</PsychicSensitivity>
        </disallowedTraitsWithDegree>
    </PawnKindDef>


    <ScenarioDef ParentName="ScenarioBase">
        <defName>Cov_Scenario</defName>
        <label>Covenant Team</label>
        <description>A Team of Elites have been sent on a mission to look for forerunner tech on this sector while the rest of the fleet lay  siege to the planet, Will you follow order or will you pick your own path.</description>
        <scenario>
            <name>Covenant Team</name>
            <summary>A Team of Elites have been sent on a mission to look for forerunner tech on this sector.</summary>
            <description>The Gods forgotten tech is somwhere on this world....Find it, Shipmaster out."</description>
            <playerFaction>
                <def>PlayerFaction</def>
                <factionDef>PlayerColony</factionDef>
            </playerFaction>
            <parts>
                <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
                    <def>ConfigPage_ConfigureStartingPawns</def>
                    <summarized>true</summarized>
                    <pawnChoiceCount>3</pawnChoiceCount>
                    <leftBehindPawnKind>Cov_EliteCiv</leftBehindPawnKind>
                    <kindCounts>
                        <li>
                            <kindDef>Cov_Major_Elite</kindDef>
                            <count>1</count>
                            <requiredAtStart>true</requiredAtStart>
                        </li>
                    </kindCounts>
                </li>
                <li Class="ScenPart_PlayerPawnsArriveMethod">
                    <def>PlayerPawnsArriveMethod</def>
                    <method>Standing</method>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MealSurvivalPack</thingDef>
                    <count>40</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MedicineIndustrial</thingDef>
                    <count>10</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>ComponentIndustrial</thingDef>
                    <count>20</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>ComponentSpacer</thingDef>
                    <count>4</count>
                </li>
                <li Class="VEF.Factions.ScenPart_ForcedFactionGoodwill" MayRequire="oskarpotocki.vanillafactionsexpanded.core">
                    <factionDef>CovenantMain</factionDef>
                    <affectHiddenFactions>True</affectHiddenFactions>
                    <affectStartingGoodwill>True</affectStartingGoodwill>
                    <startingGoodwillRange>60~80</startingGoodwillRange>
                    <affectNaturalGoodwill>True</affectNaturalGoodwill>
                    <naturalGoodwillRange>56~63</naturalGoodwillRange>
                    <def>VFEC_ForcedFactionGoodwill</def>
                </li>
                <li Class="ScenPart_GameStartDialog">
                    <def>GameStartDialog</def>
                    <text>The Shipmaster orders are absolute, we must not fail less we bring dishonor apon our kin.</text>
                    <textKey>GameStartDialog</textKey>
                    <closeSound>GameStartSting</closeSound>
                </li>
            </parts>
        </scenario>
    </ScenarioDef>
</Defs>