<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--********************* Elite *********************-->
    <ThingDef ParentName="BaseFilth">
        <defName>Purple_BloodSmear</defName>
        <label>Purple blood</label>
        <statBases>
            <Beauty>-30</Beauty>
            <Cleanliness>-10</Cleanliness>
        </statBases>
        <graphicData>
            <texPath>Things/Filth/Spatter</texPath>
            <color>(40, 16, 81, 180)</color>
        </graphicData>
        <filth>
            <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
            <disappearsInDays>35~40</disappearsInDays>
            <rainWashes>true</rainWashes>
            <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
            <canFilthAttach>true</canFilthAttach>
            <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
        </filth>
    </ThingDef>

    <!--********************* Grunt&Brutes *********************-->
    <ThingDef ParentName="BaseFilth">
        <defName>Teal_BloodSmear</defName>
        <label>Teal blood</label>
        <statBases>
            <Beauty>-30</Beauty>
            <Cleanliness>-10</Cleanliness>
        </statBases>
        <graphicData>
            <texPath>Things/Filth/Spatter</texPath>
            <color>(81,200,204,255)</color>
        </graphicData>
        <filth>
            <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
            <disappearsInDays>35~40</disappearsInDays>
            <rainWashes>true</rainWashes>
            <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
            <canFilthAttach>true</canFilthAttach>
            <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
        </filth>
    </ThingDef>

</Defs>