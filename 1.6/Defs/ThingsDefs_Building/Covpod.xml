<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Cov_pod</defName>
    <label>Insertion Pod</label>
    <description>The Orbital Insertion Pod is a single-occupant, Covenant-manufactured, high-altitude deployment vehicle.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Building/CovPod/Cov_Pod</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>BuildingBelowTop</altitudeLayer>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Chemfuel>65</Chemfuel>
    </costList>
    <rotatable>false</rotatable>
    <fillPercent>0.5</fillPercent>
    <uiIconScale>0.65</uiIconScale>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>TransportPod</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <uiIconScale>0.65</uiIconScale>
    <designationCategory>Covenant_Tech</designationCategory>
    <building>
      <claimable>true</claimable>
      <deconstructible>true</deconstructible>
      <repairable>false</repairable>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="CompProperties_Transporter">
        <restEffectiveness>1.0</restEffectiveness>
        <massCapacity>1000</massCapacity>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <max1PerGroup>true</max1PerGroup>
      </li>
      <li Class="CompProperties_Launchable_TransportPod">
        <skyfallerLeaving>DropPodLeaving</skyfallerLeaving> 
        <requiresFuelingPort>false</requiresFuelingPort>
        <fixedLaunchDistanceMax>25</fixedLaunchDistanceMax> 
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Cov_DropPodS</defName>
    <label>Orbital Insertion Pod</label>
    <description>The Orbital Insertion Pod is a single-occupant, Covenant-manufactured, high-altitude deployment vehicle.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Building/CovPod/Cov_PodS</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>BuildingBelowTop</altitudeLayer>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Chemfuel>30</Chemfuel>
    </costList>
    <rotatable>false</rotatable>
    <fillPercent>0.5</fillPercent>
    <uiIconScale>0.65</uiIconScale>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>TransportPod</li>
      <li>OrbitalTech</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <uiIconScale>0.65</uiIconScale>
    <designationCategory>Covenant_Tech</designationCategory>
    <building>
      <claimable>true</claimable>
      <deconstructible>true</deconstructible>
      <repairable>false</repairable>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="CompProperties_Transporter">
        <restEffectiveness>1.8</restEffectiveness>
        <massCapacity>1500</massCapacity>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <max1PerGroup>true</max1PerGroup>
      </li>
      <li Class="CompProperties_Launchable_TransportPod">
        <skyfallerLeaving>Cov_DropPodSLeaving</skyfallerLeaving>
        <requiresFuelingPort>false</requiresFuelingPort>
        <fixedLaunchDistanceMax>50</fixedLaunchDistanceMax>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>Cov_DropPodLeaving</defName>
    <label>drop pod (leaving)</label>
    <thingClass>FlyShipLeaving</thingClass>
    <graphicData>
      <texPath>Building/CovPod/Cov_PodS</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>1.9</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <reversed>true</reversed>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(3, 3)</shadowSize>
      <anticipationSound>DropPod_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange><min>-40</min><max>-15</max></ticksToImpactRange>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>Cov_DropPodSLeaving</defName>
    <label>drop pod (leaving)</label>
    <thingClass>FlyShipLeaving</thingClass>
    <graphicData>
      <texPath>Building/CovPod/Cov_PodS</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>1.9</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <reversed>true</reversed>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(3, 3)</shadowSize>
      <anticipationSound>DropPod_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange><min>-40</min><max>-15</max></ticksToImpactRange>
    </skyfaller>
  </ThingDef>

</Defs>