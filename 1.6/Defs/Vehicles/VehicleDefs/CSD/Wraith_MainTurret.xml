<?xml version="1.0" encoding="utf-8"?>

<Defs>
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>Wraith_MainTurret</defName>
		<label>Wraith cannon</label>
		<description>Wraith Plasma cannon.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>Shot_Wraith</shotSound>
		
		<projectile>Bullet_ConcussiveBolt</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.4</warmUpTimer>
		
		<magazineCapacity>1</magazineCapacity>
		<genericAmmo>true</genericAmmo>
		
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>1.95</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>2</minRange>
		<maxRange>100</maxRange>
		
		<recoil>
			<distanceTotal>0.15</distanceTotal>
			<distancePerTick>0.05</distancePerTick>
			<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
		</recoil>
		
		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>20</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>

        <accuracyTouch>0.28</accuracyTouch>
        <accuracyShort>0.72</accuracyShort>
        <accuracyMedium>0.66</accuracyMedium>
        <accuracyLong>0.50</accuracyLong>
			</li>
		</fireModes>

		<graphicData>
			<texPath>Wraith/Wraith_cannon</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(2, 3)</drawSize>
		</graphicData>
		
		<ammunition>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</ammunition>
	</Vehicles.VehicleTurretDef>
</Defs>